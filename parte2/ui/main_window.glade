<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.20"/>
  <object class="GtkAdjustment" id="variables_adjustment">
    <property name="lower">2</property>
    <property name="upper">15</property>
    <property name="value">2</property>
    <property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="constraints_adjustment">
    <property name="lower">2</property>
    <property name="upper">15</property>
    <property name="value">2</property>
    <property name="step-increment">1</property>
  </object>
  <object class="GtkWindow" id="main_window">
    <property name="can-focus">False</property>
    <property name="title">Otro SIMPLEX más</property>
    <property name="default-width">1120</property>
    <property name="default-height">660</property>
    <property name="window-position">center</property>
    <signal name="destroy" handler="on_main_window_destroy" swapped="no"/>

    <!-- Barra de título con los controles principales, como en Glade -->
    <child type="titlebar">
      <object class="GtkHeaderBar" id="header_bar">
        <property name="visible">True</property>
        <property name="title">Otro SIMPLEX más</property>
        <property name="subtitle">Método Símplex y Gran M</property>
        <property name="show-close-button">True</property>
        <child>
          <object class="GtkComboBoxText" id="sample_combo">
            <property name="visible">True</property>
            <property name="tooltip-text">Llena el formulario con un problema resuelto a mano en clase</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="solve_button">
            <property name="visible">True</property>
            <property name="label">Resolver</property>
            <property name="tooltip-text">Resuelve el problema y abre el documento PDF</property>
            <style>
              <class name="suggested-action"/>
            </style>
          </object>
          <packing>
            <property name="pack-type">end</property>
          </packing>
        </child>
      </object>
    </child>

    <child>
      <object class="GtkBox" id="content_box">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>

        <!-- Panel izquierdo con los datos del problema y panel central con el modelo -->
        <child>
          <object class="GtkPaned" id="main_paned">
            <property name="visible">True</property>
            <property name="position">310</property>
            <property name="wide-handle">True</property>

            <child>
              <object class="GtkScrolledWindow">
                <property name="visible">True</property>
                <property name="hscrollbar-policy">never</property>
                <child>
                  <object class="GtkBox" id="properties_box">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <property name="margin">16</property>
                    <property name="width-request">280</property>

                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label">Problema</property>
                        <property name="xalign">0</property>
                        <attributes>
                          <attribute name="weight" value="bold"/>
                          <attribute name="scale" value="1.15"/>
                        </attributes>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label">Nombre del problema</property>
                        <property name="xalign">0</property>
                        <property name="margin-top">4</property>
                        <style><class name="dim-label"/></style>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>
                    <child>
                      <object class="GtkEntry" id="problem_name_entry">
                        <property name="visible">True</property>
                        <property name="max-length">63</property>
                        <property name="placeholder-text">Escriba un nombre</property>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label">Objetivo</property>
                        <property name="xalign">0</property>
                        <property name="margin-top">4</property>
                        <style><class name="dim-label"/></style>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>
                    <child>
                      <object class="GtkComboBoxText" id="objective_combo">
                        <property name="visible">True</property>
                        <property name="active">0</property>
                        <items>
                          <item translatable="no">Maximizar</item>
                          <item translatable="no">Minimizar</item>
                        </items>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>

                    <child>
                      <object class="GtkSeparator">
                        <property name="visible">True</property>
                        <property name="margin-top">10</property>
                        <property name="margin-bottom">4</property>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label">Tamaño</property>
                        <property name="xalign">0</property>
                        <attributes>
                          <attribute name="weight" value="bold"/>
                          <attribute name="scale" value="1.15"/>
                        </attributes>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>
                    <child>
                      <object class="GtkGrid">
                        <property name="visible">True</property>
                        <property name="row-spacing">8</property>
                        <property name="column-spacing">12</property>
                        <property name="margin-top">4</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label">Variables</property>
                            <property name="xalign">0</property>
                            <property name="hexpand">True</property>
                          </object>
                          <packing><property name="left-attach">0</property><property name="top-attach">0</property></packing>
                        </child>
                        <child>
                          <object class="GtkSpinButton" id="variables_spin">
                            <property name="visible">True</property>
                            <property name="adjustment">variables_adjustment</property>
                            <property name="numeric">True</property>
                          </object>
                          <packing><property name="left-attach">1</property><property name="top-attach">0</property></packing>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label">Restricciones</property>
                            <property name="xalign">0</property>
                          </object>
                          <packing><property name="left-attach">0</property><property name="top-attach">1</property></packing>
                        </child>
                        <child>
                          <object class="GtkSpinButton" id="constraints_spin">
                            <property name="visible">True</property>
                            <property name="adjustment">constraints_adjustment</property>
                            <property name="numeric">True</property>
                          </object>
                          <packing><property name="left-attach">1</property><property name="top-attach">1</property></packing>
                        </child>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>

                    <child>
                      <object class="GtkSeparator">
                        <property name="visible">True</property>
                        <property name="margin-top">10</property>
                        <property name="margin-bottom">4</property>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label">Documento</property>
                        <property name="xalign">0</property>
                        <attributes>
                          <attribute name="weight" value="bold"/>
                          <attribute name="scale" value="1.15"/>
                        </attributes>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="intermediate_check">
                        <property name="visible">True</property>
                        <property name="label">Mostrar tablas intermedias</property>
                        <property name="active">False</property>
                        <property name="margin-top">4</property>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>

                    <child>
                      <object class="GtkSeparator">
                        <property name="visible">True</property>
                        <property name="margin-top">10</property>
                        <property name="margin-bottom">4</property>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label">Ayuda</property>
                        <property name="xalign">0</property>
                        <attributes>
                          <attribute name="weight" value="bold"/>
                          <attribute name="scale" value="1.15"/>
                        </attributes>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label">Coeficientes: enteros, decimales (0.25 o 0,25) o fracciones (1/3). Un campo vacío vale 0. La primera fila tiene los nombres de las variables, que se escriben como LaTeX.</property>
                        <property name="wrap">True</property>
                        <property name="xalign">0</property>
                        <property name="margin-top">4</property>
                        <style><class name="dim-label"/></style>
                      </object>
                      <packing><property name="expand">False</property></packing>
                    </child>
                  </object>
                </child>
              </object>
              <packing>
                <property name="resize">False</property>
                <property name="shrink">False</property>
              </packing>
            </child>

            <child>
              <object class="GtkBox" id="model_box">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">8</property>
                <property name="margin">16</property>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="label">Modelo: función objetivo y restricciones</property>
                    <property name="xalign">0</property>
                    <attributes>
                      <attribute name="weight" value="bold"/>
                      <attribute name="scale" value="1.15"/>
                    </attributes>
                  </object>
                  <packing><property name="expand">False</property></packing>
                </child>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="visible">True</property>
                    <property name="shadow-type">in</property>
                    <child>
                      <object class="GtkGrid" id="model_grid">
                        <property name="visible">True</property>
                        <property name="row-spacing">4</property>
                        <property name="column-spacing">4</property>
                        <property name="margin">10</property>
                      </object>
                    </child>
                  </object>
                  <packing><property name="expand">True</property></packing>
                </child>
              </object>
              <packing>
                <property name="resize">True</property>
                <property name="shrink">False</property>
              </packing>
            </child>
          </object>
          <packing><property name="expand">True</property></packing>
        </child>

        <!-- Barra inferior con el estado de la última acción -->
        <child>
          <object class="GtkActionBar" id="status_bar">
            <property name="visible">True</property>
            <child>
              <object class="GtkLabel" id="status_label">
                <property name="visible">True</property>
                <property name="xalign">0</property>
                <property name="wrap">True</property>
                <property name="selectable">True</property>
                <property name="label">Listo. Escriba un problema o cargue un ejemplo.</property>
              </object>
            </child>
          </object>
          <packing><property name="expand">False</property></packing>
        </child>
      </object>
    </child>
  </object>
</interface>
